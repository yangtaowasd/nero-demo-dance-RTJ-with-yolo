<?xml version="1.0"?>
<robot name="nero_single_from_agx_arm_description" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    The official Nero URDF does not expose a xacro prefix argument, so a true
    dual-arm robot_description would collide on link/joint names.

    Use launch/nero_dual_side_mount_display.launch.py for mirrored dual-arm
    simulation. It starts two robot_state_publisher instances from
    urdf/nero_description.urdf and applies left/right frame_prefix values.
  -->
  <xacro:include filename="nero_description.urdf"/>
</robot>
