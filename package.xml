<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo2</name>
  <version>0.0.0</version>
  <description>RGB-D human pose mirroring for dual Nero robot arms.</description>
  <maintainer email="yang@todo.todo">yang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>rclcpp</depend>

  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>
  <!-- depth_pose_detector_cpp links the installed PyTorch LibTorch runtime. -->
  <depend>python3-torch</depend>
  <depend>geometry_msgs</depend>

  <depend>python3-numpy</depend>
  <!-- pyAgxArm is installed from AgileX; python-can is its CAN transport. -->
  <exec_depend>python3-can</exec_depend>
  <exec_depend>armbycontroller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>


  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
